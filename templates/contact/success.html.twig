{% extends 'base.html.twig' %}

{% block title %}Message Sent Successfully{% endblock %}

{% block body %}
<div class="container contact-form-container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="alert alert-success no-print mb-4" role="alert">
                <h4 class="alert-heading">Success!</h4>
                <p>Your message has been sent successfully. We'll get back to you soon.</p>
            </div>

            <div class="card">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">Submission Summary</h3>
                    <button id="printButton" class="btn btn-light btn-sm no-print">
                        <i class="bi bi-printer"></i> Print
                    </button>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <strong>Name:</strong>
                        </div>
                        <div class="col-md-9">
                            {{ submission.name }}
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <strong>Email:</strong>
                        </div>
                        <div class="col-md-9">
                            <a href="mailto:{{ submission.email }}" class="no-print">{{ submission.email }}</a>
                            <span class="d-none d-print-inline">{{ submission.email }}</span>
                        </div>
                    </div>

                    {% if submission.subject %}
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <strong>Subject:</strong>
                        </div>
                        <div class="col-md-9">
                            {{ submission.subject }}
                        </div>
                    </div>
                    {% endif %}

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <strong>Submitted At:</strong>
                        </div>
                        <div class="col-md-9">
                            {{ submission.submittedAt|date('F j, Y \\a\\t g:i A') }}
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-3">
                            <strong>Message:</strong>
                        </div>
                        <div class="col-md-9">
                            <div class="border rounded p-3 bg-light">
                                {{ submission.message|nl2br }}
                            </div>
                        </div>
                    </div>

                    {% if submission.metadata|length > 0 %}
                    <div class="row">
                        <div class="col-12">
                            <hr>
                            <h5 class="text-muted">Submission Details</h5>
                            <small class="text-muted">
                                {% for meta in submission.metadata %}
                                    <div><strong>{{ meta.metaKey|title }}:</strong> {{ meta.metaValue }}</div>
                                {% endfor %}
                            </small>
                        </div>
                    </div>
                    {% endif %}
                </div>
                <div class="card-footer no-print">
                    <a href="{{ path('app_contact') }}" class="btn btn-primary">
                        <i class="bi bi-arrow-left"></i> Submit Another Message
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @media print {
        .no-print,
        .no-print * {
            display: none !important;
        }
        
        .d-print-inline {
            display: inline !important;
        }
    }
</style>
{% endblock %}
